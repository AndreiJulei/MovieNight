# Server Port
server.port=8080

# Database Configuration (H2 In-Memory for development & testing)
spring.datasource.url=jdbc:h2:mem:movienightdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

# H2 Web Console (accessible at http://localhost:8080/h2-console)
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# JPA / Hibernate Configuration
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# JWT Secret (Base64 encoded 256-bit key for HMAC-SHA256)
app.jwt.secret=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
app.jwt.expiration-ms=86400000

# ==========================================
# External Movie API Keys (Paste your keys here)
# ==========================================
app.tmdb.api-key=PASTE_YOUR_TMDB_API_KEY_HERE
app.omdb.api-key=PASTE_YOUR_OMDB_API_KEY_HERE

# Base URLs
app.tmdb.base-url=https://api.themoviedb.org/3
app.tmdb.image-base-url=https://image.tmdb.org/t/p
app.omdb.base-url=https://www.omdbapi.com
